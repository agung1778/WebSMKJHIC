# Salin file ini ke .deploy.env pada folder utama project (sejajar artisan).
# Gunakan Document Root domain yang tertera di cPanel > Domains.
DEPLOY_PUBLIC_PATH="/home/NAMA_AKUN/public_html"
DEPLOY_BRANCH="master"

# Jika hosting memiliki beberapa versi PHP, gunakan executable yang sesuai.
# Contoh cPanel: /opt/cpanel/ea-php82/root/usr/bin/php
DEPLOY_PHP_BIN="php"
